<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.recoverkit.vibrate"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="33" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application android:label="RecoverKit Vibrate">
        <receiver
            android:name="com.recoverkit.audio.VibrateHelper"
            android:exported="true">
            <intent-filter>
                <action android:name="com.recoverkit.action.VIBRATE_START" />
                <action android:name="com.recoverkit.action.VIBRATE_STOP" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
